# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GST Verification & Auto-Fill Integration API Secrets
# Authorized GST Verification API key from an official GSP or provider
# Supported providers: Sandbox.co.in (Recommended), MasterGST, ClearTax, or custom government GSP
GST_API_KEY=""
GST_API_SECRET=""
GST_PROVIDER="sandbox" # Options: 'sandbox' | 'mastergst' | 'cleartax' | 'custom'
GST_API_BASE_URL=""    # Optional custom gateway URL, defaults to official endpoints

# E-Invoice NIC / GSP Integration Secrets (Government IRP v1.03)
# Keep EINVOICE_SANDBOX_MODE="true" for safe development and demonstration testing.
# Set to "false" ONLY after configuring authorized production credentials from NIC/GSP.
EINVOICE_SANDBOX_MODE="true"
EINVOICE_CLIENT_ID=""
EINVOICE_CLIENT_SECRET=""
EINVOICE_USER_NAME=""
EINVOICE_PASSWORD=""
EINVOICE_GSTIN=""

# E-Way Bill NIC / GSP Integration Secrets (GST Rule 138)
# Keep EWAYBILL_SANDBOX_MODE="true" for safe development and demonstration testing.
# Set to "false" ONLY after configuring authorized production credentials from NIC/GSP.
EWAYBILL_SANDBOX_MODE="true"
EWAYBILL_CLIENT_ID=""
EWAYBILL_CLIENT_SECRET=""
EWAYBILL_USER_NAME=""
EWAYBILL_PASSWORD=""
EWAYBILL_GSTIN=""
